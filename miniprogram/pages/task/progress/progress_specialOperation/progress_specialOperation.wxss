/* 课程进度表样式 */
.schedule-list {
  padding: 10rpx 30rpx 30rpx;
}

.single-schedule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  transition: all 0.3s;
}

.single-schedule-item:last-child {
  margin-bottom: 0;
}

.single-schedule-item.done {
  background-color: #f0f9eb; /* 已完成背景色 */
  border: 1rpx solid #e1f3d8;
}

.single-schedule-item.history-summary-item {
  background-color: #fafafa;
  border: 2rpx dashed #d9d9d9;
}

.schedule-left {
  display: flex;
  flex-direction: column;
}

.lesson-index {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.lesson-status-tag {
  display: inline-flex;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background-color: #e6f7ff;
  color: #1890ff;
  width: fit-content;
}

/* 状态颜色 */
.lesson-status-tag.pending { background-color: #fff7e6; color: #fa8c16; }
.lesson-status-tag.done { background-color: #f6ffed; color: #52c41a; }

.schedule-action {
  display: flex;
  align-items: center;
}

.action-text {
  font-size: 26rpx;
  color: #999;
  margin-right: 8rpx;
}

.icon-right {
  font-size: 24rpx;
  color: #ccc;
}

/* Add Lesson Button */
.add-lesson-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background-color: #f8f9fc;
  border-radius: 16rpx;
  border: 2rpx dashed #d9d9d9;
  margin-top: 20rpx;
  color: #666;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s;
}

.schedule-tool-row {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.schedule-tool-row .add-lesson-btn {
  flex: 1;
  margin-top: 0;
}

.add-lesson-btn.secondary {
  background-color: #f0f5ff;
  border-color: #adc6ff;
  color: #2f54eb;
}

.add-lesson-btn:active {
  background-color: #f0f0f0;
  border-color: #bfbfbf;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
  color: #999;
  line-height: 1;
}

.sync-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.progress-count-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.progress-count-chip {
  font-size: 22rpx;
  line-height: 1;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background-color: #f5f5f5;
  color: #666;
}

.progress-count-chip.done {
  background-color: #f6ffed;
  color: #52c41a;
}

.progress-count-chip.pending {
  background-color: #fff7e6;
  color: #d48806;
}

.progress-count-chip.total {
  background-color: #e6f7ff;
  color: #1890ff;
}

.sync-note {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
  background-color: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.container {
  padding-bottom: 120rpx; /* 底部留白 */
  background-color: #f8f9fc;
  min-height: 100vh;
}

/* 顶部状态栏占位 */
.status-bar-placeholder {
  width: 100%;
  background: transparent;
}

/* 进度条样式 */
.progress-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 30rpx;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.step-text {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.step-item.active .step-circle {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.step-item.active .step-text {
  color: #333;
  font-weight: bold;
}

.step-line {
  flex: 1;
  height: 4rpx;
  background-color: #f0f0f0;
  margin: 0 10rpx;
  margin-bottom: 36rpx; /* Align with circle center roughly */
  transform: translateY(-10rpx);
}

.step-line.active {
  background-color: #1890ff;
}

.progress-comment {
  padding: 24rpx 30rpx;
  background-color: #e6f7ff;
  border-radius: 16rpx;
  margin: 0 30rpx 30rpx;
  font-size: 26rpx;
  color: #1890ff;
  line-height: 1.5;
}

/* 班级展示说明头部：支持提示当前会自动收起，并提供手动展开/收起入口 */
.display-guide-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.display-guide-header-main {
  display: flex;
  flex-direction: column;
}

.display-guide-header-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.display-guide-toggle {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: 600;
}

/* 班级展示页说明：改成标题+分段说明，方便家长和教练快速理解页面职责 */
.display-guide-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1257b3;
}

.display-guide-row {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background-color: rgba(255, 255, 255, 0.72);
}

.display-guide-value {
  display: block;
  font-size: 24rpx;
  color: #1565c0;
  line-height: 1.7;
}

.display-guide-collapsed {
  margin: 0 30rpx 30rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background-color: #f5f9ff;
  font-size: 24rpx;
  color: #1565c0;
  line-height: 1.6;
  text-align: center;
}

/* 通用卡片样式 */
.course-card {
  width: 92%;
  margin: 30rpx auto;
  background-color: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.card-header {
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f8f8f8;
}

.course-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #333;
}

.header-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.tag-intention {
  background-color: #e6f7ff;
  color: #1890ff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  font-weight: 500;
}

.tag-status {
  background-color: #f6ffed;
  color: #52c41a;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.card-body {
  padding: 40rpx;
}

/* 新增孩子信息卡片样式：单独成块展示，方便家长快速查看孩子基础资料 */
.child-info-card .card-header {
  background: linear-gradient(180deg, #f7fbff 0%, #ffffff 100%);
}

.child-info-body {
  padding-top: 28rpx;
}

.child-info-item {
  padding: 24rpx;
  border-radius: 18rpx;
  background: #fafcff;
  border: 1rpx solid #e8f0ff;
  margin-bottom: 20rpx;
}

.child-info-item:last-child {
  margin-bottom: 0;
}

.child-info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 18rpx;
}

.info-row {
  display: flex;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #999;
  width: 110rpx;
}

.value {
  color: #333;
  flex: 1;
  font-weight: 500;
}

.value.price {
  color: #ff4d4f;
  font-weight: bold;
  font-size: 32rpx;
}

/* 操作栏 */
.action-bar-wrapper {
  border-top: 1rpx solid #f8f8f8;
}

/* 新增课程重点折叠区：放在课程信息卡片底部，默认收起减少信息堆叠 */
.sub-plan-panel {
  border-top: 1rpx solid #f2f4f7;
  background-color: #fafcff;
}

.sub-plan-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 40rpx;
}

.sub-plan-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.sub-plan-toggle {
  font-size: 24rpx;
  color: #1890ff;
}

.sub-plan-body {
  padding: 0 40rpx 32rpx;
}

.sub-plan-row {
  display: flex;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.sub-plan-row:last-child {
  margin-bottom: 0;
}

.action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx;
}

.status-text {
  font-size: 26rpx;
  color: #666;
  display: flex;
  align-items: center;
  background: #f5f5f5;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
}

.edit-hint {
  margin-left: 10rpx;
  color: #999;
}

.action-right {
  display: flex;
  align-items: center;
}

.expand-trigger {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 10rpx solid #ccc;
  margin-left: 8rpx;
  transition: transform 0.3s;
}

.arrow.up {
  transform: rotate(180deg);
}

.action-btn {
  font-size: 26rpx;
  padding: 0 32rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 30rpx;
  margin: 0;
  font-weight: 600;
}

.btn-primary {
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  color: #fff;
  box-shadow: 0 4rpx 10rpx rgba(24, 144, 255, 0.2);
}

.btn-disable {
  background-color: #f5f5f5;
  color: #ccc;
}

/* 意愿列表 */
.intentions-panel {
  background-color: #fafafa;
  padding: 0 40rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.participant-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.participant-row:last-child {
  border-bottom: none;
}

.p-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #eee;
  border: 2rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.p-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.p-status {
  font-size: 24rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.p-status.confirmed {
  color: #52c41a;
  background: #f6ffed;
  border: 1rpx solid rgba(82, 196, 26, 0.1);
}

.no-participants {
  padding: 40rpx;
  text-align: center;
  color: #ccc;
  font-size: 26rpx;
}

/* 教练反馈部分 */
.intentions-group {
    margin-bottom: 20rpx;
}

.group-title {
    font-size: 26rpx;
    color: #666;
    margin-bottom: 16rpx;
    padding-left: 16rpx;
    border-left: 6rpx solid #1890ff;
    font-weight: 600;
}

.p-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.p-desc {
    font-size: 24rpx;
    color: #999;
    margin-top: 6rpx;
}

/* 底部按钮栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background-color: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: space-between;
  box-sizing: border-box;
  z-index: 100;
}

.btn-main {
  flex: 1;
  margin: 0 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.parent-op {
  background-color: #fff;
  color: #333;
  border: 2rpx solid #eee;
}

.edit-op {
  background-color: #e6f7ff;
  color: #1677ff;
  border: 2rpx solid #b7dcff;
}

/* 新增操作栏内修改按钮样式：保留原按钮类名，但缩成操作栏尺寸 */
.action-right .btn-main.edit-op {
  flex: none;
  width: auto;
  min-width: 160rpx;
  height: 60rpx;
  line-height: 60rpx;
  margin: 0 16rpx 0 0;
  padding: 0 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

.modal-container {
  width: 85%;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 48rpx rgba(0, 0, 0, 0.15);
  animation: modalScaleIn 0.2s ease;
}

@keyframes modalScaleIn {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: bold;
  border-bottom: 1rpx solid #f0f0f0;
  color: #333;
}

.modal-content {
  padding: 40rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-label.required::after {
  content: '*';
  color: #ff4d4f;
  margin-left: 4rpx;
}

.form-input {
  border: 1rpx solid #e8e8e8;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #f9f9f9;
  transition: all 0.2s;
}

.form-input:focus {
  background: #fff;
  border-color: #1890ff;
}

.stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #e8e8e8;
  border-radius: 12rpx;
  width: 220rpx;
  overflow: hidden;
}

.step-btn {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f5f5f5;
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.step-btn:active {
  background-color: #e6e6e6;
}

.step-btn.disabled {
  color: #ccc;
  background-color: #f9f9f9;
}

.step-num {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  border-left: 1rpx solid #e8e8e8;
  border-right: 1rpx solid #e8e8e8;
  height: 70rpx;
  line-height: 70rpx;
  font-weight: 600;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.btn-cancel, .btn-submit {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  font-size: 32rpx;
  margin: 0;
  border-radius: 0;
  background-color: #fff;
  border: none;
}

.btn-cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.btn-submit {
  color: #1890ff;
  font-weight: bold;
}

.btn-submit:active {
  background-color: #f0f9ff;
}

/* 课表样式 */
.schedule-list {
  padding: 0 40rpx 40rpx;
}

.single-schedule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0; /* 拉长高度 */
  border-bottom: 1rpx solid #f5f5f5;
  min-height: 100rpx;
}

.schedule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.schedule-item:last-child {
  border-bottom: none;
}

.schedule-item.done .lesson-index {
  color: #ccc;
  text-decoration: line-through;
}

.schedule-left {
  display: flex;
  flex-direction: column;
}

.lesson-index {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.lesson-status-tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  color: #999;
  width: fit-content;
  font-weight: 500;
}

.lesson-status-tag.pending {
  background-color: #fff7e6;
  color: #d48806;
}

.lesson-status-tag.done {
  background-color: #f6ffed;
  color: #52c41a;
}

.lesson-status-tag.history {
  background-color: #f0f5ff;
  color: #2f54eb;
}

.schedule-action {
  display: flex;
  align-items: center;
}

.action-text.done {
  color: #52c41a;
}

.action-text.pending {
  color: #d48806;
}

.btn-mini {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  line-height: 1.5;
  font-weight: 500;
}

.btn-ready {
  background-color: #1890ff;
  color: #fff;
}

.btn-confirm {
  background-color: #52c41a;
  color: #fff;
}

.wait-text {
  font-size: 24rpx;
  color: #999;
}

.done-text {
  font-size: 24rpx;
  color: #52c41a;
  font-weight: bold;
}

/* 4. 教练等待提示栏样式 */
.waiting-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #fff; 
}

.waiting-text {
  font-size: 32rpx;
  color: #1890ff;
  font-weight: bold;
}

/* 新增分享态提示条：提醒当前页面只保留展示和下钻能力 */
.share-entry-banner {
  width: 92%;
  margin: 24rpx auto 0;
  padding: 22rpx 28rpx;
  border-radius: 18rpx;
  background-color: #fff7e6;
  color: #ad6800;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.share-entry-banner-text {
  color: #ad6800;
}

/* 新增分享本人按钮样式：分享页里给所属教练一个显眼但不刺眼的回操作台入口 */
.share-owner-console-btn {
  margin-top: 18rpx;
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background-color: #fff;
  color: #ad6800;
  border: 2rpx solid rgba(173, 104, 0, 0.18);
  font-size: 28rpx;
  font-weight: 600;
}

.share-owner-console-btn::after {
  border: none;
}
