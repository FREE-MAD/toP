<view class="container">
  <view style="height: {{statusBarHeight}}px; width: 100%;"> <!-- 顶部安全区 --> </view>

  <!-- 新增分享态提示：分享进入优先走只读展示模式 -->
  <view class="share-entry-banner" wx:if="{{isShareEntry}}">
    <view class="share-entry-banner-text">
      {{pageMode === 'share_owner' ? '当前是你自己的分享页，先按家长视角预览；需要调整内容可直接回操作台。' : '当前为分享查看模式，可继续查看课节详情，不提供教练操作入口。'}}
    </view>
    <!-- 新增分享本人回操作台入口：课程分享页只给所属教练一个明确返回操作台的按钮 -->
    <button
      wx:if="{{pageMode === 'share_owner' && isOwner}}"
      class="share-owner-console-btn"
      bindtap="handleGoCoachConsole"
    >
      回到教练操作台
    </button>
  </view>

        <!-- 家长展示页直接隐藏顶部说明卡，首屏只保留家长真正需要看的课程内容 -->
        <view class="course-card" wx:if="{{pageMode !== 'share_viewer'}}">
         <view class="card-header display-guide-header" bindtap="toggleDisplayGuide">
           <view class="display-guide-header-main">
             <text class="course-title">班级展示说明</text>
             <text class="display-guide-header-sub">默认展示 5 秒后自动收起</text>
           </view>
           <text class="display-guide-toggle">{{isDisplayGuideExpanded ? '收起' : '展开'}}</text>
         </view>

    <!-- 旧“发布-上课-完成”步骤条保留注释，不删除；当前页面不再按课程状态推进展示 -->
    <!--
    <view class="progress-steps">
      <view class="step-item {{currentStep >= 0 ? 'active' : ''}}">
        <view class="step-circle">1</view>
        <text class="step-text">发布</text>
      </view>
      <view class="step-line {{currentStep >= 1 ? 'active' : ''}}"></view>

      <view class="step-item {{currentStep >= 1 ? 'active' : ''}}">
        <view class="step-circle">2</view>
        <text class="step-text">上课</text>
      </view>
      <view class="step-line {{currentStep >= 2 ? 'active' : ''}}"></view>

      <view class="step-item {{currentStep >= 2 ? 'active' : ''}}">
        <view class="step-circle">3</view>
        <text class="step-text">完成</text>
      </view>
    </view>
    -->

                <view class="progress-comment" wx:if="{{isDisplayGuideExpanded}}">
            <!-- 班级展示页说明：明确告诉用户这个页面的用途、同步关系和家长权限边界 -->
            <view class="display-guide-title">班级展示页面</view>
            <view class="display-guide-row">
              <text class="display-guide-value">班级展示页面是教练完成班级及课程相关设置后的对外展示页面。</text>
            </view>
            <view class="display-guide-row">
              <text class="display-guide-value">教练在管理班级中完成课程、课节、每日总结等内容后，展示页面会同步更新对应信息。</text>
            </view>
            <view class="display-guide-row">
              <text class="display-guide-value">该页面主要用于分享给家长查看，家长可以了解孩子所在班级的课程安排、上课情况及相关信息。</text>
            </view>
            <view class="display-guide-row">
              <text class="display-guide-value">家长仅拥有查看权限，无法修改、发布或管理班级内容。所有班级信息及内容的调整，均由教练在“管理班级”中完成。</text>
            </view>
          </view>
                <view class="display-guide-collapsed" wx:else bindtap="toggleDisplayGuide">
                  班级展示页面说明已收起，点此展开
                </view>
  </view>

  <!-- 新增孩子信息卡片：按你的 selector 要求，放到根节点第 3 个 view 下面的同级位置 -->
  <!-- 新增空态隐藏：没有真实填写的孩子资料时，整张卡片不显示 -->
  <view class="course-card child-info-card" wx:if="{{order.child_profiles && order.child_profiles.length > 0}}">
    <view class="card-header">
      <view class="header-row">
        <text class="tag-intention">孩子信息</text>
      </view>
      <view class="course-title">当前孩子基础资料</view>
    </view>

    <view class="card-body child-info-body">
      <!-- 新增多孩子展示：一个课程里可以连续展示多个孩子的基础资料 -->
      <block wx:for="{{order.child_profiles}}" wx:key="index">
        <view class="child-info-item">
          <view class="child-info-title">{{item.nickname ? item.nickname : ('孩子' + (index + 1))}}</view>
          <view class="info-row" wx:if="{{item.nickname}}">
            <text class="label">昵称：</text>
            <text class="value">{{item.nickname}}</text>
          </view>
          <view class="info-row" wx:if="{{item.age}}">
            <text class="label">年龄：</text>
            <text class="value">{{item.age}}岁</text>
          </view>
          <view class="info-row" wx:if="{{item.gender}}">
            <text class="label">性别：</text>
            <text class="value">{{item.gender}}</text>
          </view>
          <view class="info-row" wx:if="{{item.height}}">
            <text class="label">身高：</text>
            <text class="value">{{item.height}}cm</text>
          </view>
          <view class="info-row" wx:if="{{item.weight}}">
            <text class="label">体重：</text>
            <text class="value">{{item.weight}}kg</text>
          </view>
        </view>
      </block>
    </view>
  </view>

  <view class="course-card">
    <view class="card-header">
      <view class="header-row">
        <text class="tag-intention">课程信息</text>
        <!-- 旧 fulfill_state 状态角标保留注释，不删除；当前只保留关闭态提示 -->
        <!-- <text class="tag-status">{{order.fulfill_state === 'completed' ? '已完成' : (order.fulfill_state === 'in_progress' ? '进行中' : '待开始')}}</text> -->
        <text class="tag-status">{{order.fulfill_state === 'cancelled' || order.fulfill_state === 'closed' ? '已关闭' : '可查看'}}</text>
      </view>
      <view class="course-title">{{order.title || '任务详情'}}</view>
    </view>

    <view class="card-body">
      <view class="info-row" wx:if="{{order.category}}">
        <text class="label">分类：</text>
        <text class="value">{{order.category}}</text>
      </view>
      <view class="info-row" wx:if="{{order.course_size_mode}}">
        <text class="label">课程人数：</text>
        <text class="value">{{order.course_size_mode}}</text>
      </view>
      <!-- 新增锻炼时间展示：这里补回发布页填写的上课频率/时间安排 -->
      <view class="info-row" wx:if="{{order.frequency}}">
        <text class="label">锻炼时间：</text>
        <text class="value">{{order.frequency}}</text>
      </view>
      <view class="info-row">
        <text class="label">地点：</text>
        <text class="value">{{order.location || '未填写'}}</text>
      </view>
      <view class="info-row">
        <text class="label">创建：</text>
        <text class="value">{{createdTimeDisplay || '未记录'}}</text>
      </view>
    </view>
    <!-- 旧当前流程状态展示保留注释，不删除；当前不再用它表达课程是否上课/下课 -->
    <!--
    <view class="status-text">
          当前: {{statusText}}
    </view>
    -->
    <view class="status-text">
          当前: 课节详情可直接查看
    </view>
    <view class="action-bar-wrapper" wx:if="{{pageMode === 'normal' && isCoach}}">
      <view class="action-bar">
        <!-- <view class="action-right">
          新增展示页职责说明：课程操作统一迁移到 publish 教练操作台
          <button class="btn-main edit-op" bindtap="handleGoCoachConsole">进入教练操作台</button>
        </view> -->
      </view>
    </view>
    <!-- 新增 subPlans 折叠区：按需求移动到课程信息卡片最底部，默认折叠减少首屏占位 -->
    <view class="sub-plan-panel" wx:if="{{order.sub_plan_name || order.course_plan}}">
      <view class="sub-plan-header" bindtap="toggleSubPlanSection">
        <text class="sub-plan-title">训练重点</text>
        <text class="sub-plan-toggle">{{isSubPlanExpanded ? '收起' : '展开'}}</text>
      </view>
      <view class="sub-plan-body" wx:if="{{isSubPlanExpanded}}">
        <view class="sub-plan-row" wx:if="{{order.sub_plan_name}}">
          <text class="label">subPlans:</text>
          <text class="value">{{order.sub_plan_name}}</text>
        </view>
        <view class="sub-plan-row" wx:if="{{order.course_plan}}">
          <text class="label">内容：</text>
          <text class="value">{{order.course_plan}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="course-card" wx:if="{{displaySchedule && displaySchedule.length > 0}}">
    <view class="card-header">
      <text class="course-title">课程进度表</text>
      <!-- 新增表头计算展示：这里按列表中的“已完成 / 待记录 / 历史已完成”统一统计 -->
      <view class="progress-count-row">
        <text class="progress-count-chip done">已完成 {{progressCompletedCount}} 节</text>
        <text class="progress-count-chip pending">待记录 {{progressPendingCount}} 节</text>
        <text class="progress-count-chip total">共 {{progressTotalCount}} 节</text>
      </view>
      <!-- 新增半途接入说明：展示页和教练操作台保持一致，先显示历史汇总框 -->
      <view class="sync-hint" wx:if="{{historySyncedCount > 0}}">已完成前 {{historySyncedCount}} 节历史课，下面会先显示历史汇总框，再显示剩余课节。</view>
    </view>
    <view class="schedule-list">
      <block wx:for="{{displaySchedule}}" wx:key="index">
        <view
          class="single-schedule-item {{item.displayStatusClass === 'done' ? 'done' : ''}} {{item.isHistorySummary ? 'history-summary-item' : ''}}"
          bindtap="handleToClassDetail"
          data-index="{{item.actualIndex}}"
          data-history="{{item.isHistorySummary ? 1 : 0}}"
        >
          <view class="schedule-left">
            <text class="lesson-index">{{item.isHistorySummary ? ('第 ' + item.title + ' 课') : ('第 ' + (item.lesson || (index + 1)) + ' 课')}}</text>
            <!-- 旧课节状态标签类保留注释，不删除；当前统一展示为课节记录 -->
            <!-- <view class="lesson-status-tag {{item.isHistorySummary ? 'DONE' : item.status}}">{{item.statusText}}</view> -->
            <view class="lesson-status-tag {{item.displayStatusClass}} {{item.isHistorySummary ? 'history' : ''}}">{{item.statusText}}</view>
          </view>

          <view class="schedule-action">
            <text class="action-text {{item.displayStatusClass === 'done' ? 'done' : 'pending'}}">{{item.isHistorySummary ? '历史汇总' : item.statusText}}</text>
            <text class="iconfont icon-right" wx:if="{{!item.isHistorySummary}}"></text>
          </view>
        </view>
      </block>

    </view>
  </view>
</view>
