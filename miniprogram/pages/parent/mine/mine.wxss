/* 「我的」页面样式（2026-10-14 UI 升级）：统一活力蓝 + 阳光橙体系 */
.page {
  padding: 24rpx;
  background: #F0F4F8;
  min-height: 100vh;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A202C;
  margin-bottom: 12rpx;
}

.desc {
  font-size: 26rpx;
  color: #4A5568;
  line-height: 1.6;
  margin-bottom: 6rpx;
}

.primary-btn {
  margin-top: 18rpx;
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.3);
}

/* 家长资料卡 */
.profile-card {
  padding: 32rpx 24rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
}

.profile-head {
  display: flex;
  align-items: center;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.4);
}

.profile-avatar-text {
  color: #fff;
}

.profile-info {
  flex: 1;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.profile-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 常用入口 */
.entry-list {
  margin-top: 8rpx;
}

.entry-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #E2E8F0;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.entry-icon {
  font-size: 36rpx;
}

.entry-text {
  font-size: 28rpx;
  color: #1A202C;
  font-weight: 500;
}

.entry-arrow {
  font-size: 32rpx;
  color: #CBD5E1;
}
