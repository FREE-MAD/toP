/* 入口二维码落地页样式（2026-10-14 UI 升级）：统一活力蓝 + 阳光橙体系
   落地页改版：展示区升级为 organization_show 完整机构展示（与 index_firstpage 同款） */
.entry-landing {
  min-height: 100vh;
  background: #F0F4F8;
  padding: 32rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.state-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.state-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #64748B;
}

.state-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FEE2E2;
  color: #EF4444;
  font-size: 56rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #2563EB;
  animation: entry-pulse 0.9s ease-in-out infinite;
}

@keyframes entry-pulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1.2); }
}

.info-block {
  display: flex;
  flex-direction: column;
}

/* 机构展示区：深蓝灰背景 + 白色卡片堆叠（与 index_firstpage organization_show 同款） */
.organization_show {
  position: relative;
  box-sizing: border-box;
  margin: 0;
  padding: 28rpx 24rpx 40rpx;
  border-radius: 32rpx;
  background: #1E293B;
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.2);
}

.organization_show > view {
  position: relative;
  z-index: 2;
}

/* Hero 训练图卡 */
.os-hero {
  position: relative;
  height: 540rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 18rpx 40rpx rgba(15, 23, 42, 0.4);
}

.os-hero-swiper,
.os-hero-swiper swiper-item {
  width: 100%;
  height: 100%;
}

.os-hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.os-hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
}

.os-hero-placeholder-text {
  padding: 16rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.95);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.os-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 23, 42, 0.08) 0%, rgba(15, 23, 42, 0.72) 100%);
}

.os-hero-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 132rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.os-hero-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.46);
}

.os-hero-dot-active {
  width: 40rpx;
  border-radius: 999rpx;
  background: #ffffff;
}

.os-hero-text {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 36rpx;
  padding: 0 40rpx;
  text-align: center;
  color: #ffffff;
}

.os-hero-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.5);
}

.os-hero-subtitle {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.94);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* 白色卡片公用样式 */
.os-card {
  box-sizing: border-box;
  margin-top: 28rpx;
  padding: 30rpx 28rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(15, 23, 42, 0.18);
}

.os-card-head {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 26rpx;
}

.os-card-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #F97316;
}

.os-card-title {
  position: relative;
  margin: 0 16rpx;
  padding-bottom: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1A202C;
}

.os-card-title::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 44rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #F97316;
}

/* 机构简介 4 行字段列表 */
.os-intro-row {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  font-size: 28rpx;
  line-height: 1.7;
  border-bottom: 1rpx dashed #E2E8F0;
}

.os-intro-row:last-child {
  border-bottom: 0;
}

.os-intro-bullet {
  width: 14rpx;
  height: 14rpx;
  margin-top: 18rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #F97316;
  flex-shrink: 0;
}

.os-intro-label {
  color: #1A202C;
  font-weight: 600;
}

.os-intro-value {
  flex: 1;
  margin-left: 4rpx;
  color: #4A5568;
}

/* 团队成员：一人一行一个块 */
.os-team-grid {
  display: flex;
  flex-direction: column;
}

.os-team-item {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #F8FAFC;
  display: flex;
  align-items: center;
  border: 1rpx solid #E2E8F0;
}

.os-team-avatar {
  position: relative;
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.25);
  overflow: hidden;
  background: linear-gradient(135deg, #3B82F6 0%, #2563EB 100%);
}

.os-team-avatar-image {
  width: 100%;
  height: 100%;
}

.os-team-avatar-text {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.os-team-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  display: flex;
  flex-direction: column;
}

.os-team-name {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #1A202C;
}

.os-team-role {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748B;
}

.os-team-toggle {
  margin-top: 4rpx;
  padding: 16rpx 0 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #F97316;
}

.os-team-toggle-text {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
}

.os-team-toggle-arrow {
  margin-left: 8rpx;
  font-size: 20rpx;
  line-height: 1.4;
  transition: transform 0.2s ease;
}

.os-team-toggle-arrow-up {
  transform: rotate(180deg);
}

/* 机构课程卡 */
.os-course-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.os-course-item {
  box-sizing: border-box;
  width: 100%;
  border-radius: 20rpx;
  background: #f8faff;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.os-course-image {
  width: 100%;
  height: 300rpx;
  background: #eef4ff;
}

.os-course-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.os-course-placeholder-text {
  font-size: 26rpx;
  color: #8a94a6;
}

.os-course-info {
  padding: 22rpx 24rpx 26rpx;
  display: flex;
  flex-direction: column;
}

.os-course-name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #1A202C;
}

.os-course-price {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #F97316;
  font-weight: 700;
}

.os-course-duration {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #64748B;
  font-weight: 600;
}

.os-course-details {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #64748B;
}

/* 底部操作栏 */
/* 调整（2026-10-16）：该操作栏已移到机构展示区最顶部（organization_show 之前），
   原「底部」定位用的 margin-top 顶间距不再适用：改为去掉 margin-top、补 margin-bottom 与下方展示区留白，
   其余按钮样式（.btn / .btn-primary / .btn-ghost）保持不变。 */
.action-bar {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
  padding: 0;
  font-weight: 600;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  color: #FFFFFF;
  box-shadow: 0 6rpx 16rpx rgba(59, 130, 246, 0.3);
}

.btn-ghost {
  background: #FFFFFF;
  color: #2563EB;
  border: 2rpx solid #BFDBFE;
}

/* 新增（2026-10-16）：操作区「左按钮 + 右说明」3 行组合样式 ——
   每行用 flex 横向排版：左边按钮定宽不伸缩，右边说明自适应占满剩余宽度；
   必须放在 .btn 之后，才能覆盖 .btn 的 width:100%（同权重下后者生效）。 */
.action-item {
  display: flex;
  align-items: center;
}

.action-btn {
  flex: none;
  width: 240rpx;
}

.action-desc {
  flex: 1;
  margin-left: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #64748B;
}
